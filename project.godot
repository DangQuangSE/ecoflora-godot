; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="flow-flora-godot"
run/main_scene="res://scenes/auth/LoginScene.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

LoadingScreen="*res://autoloads/LoadingScreen.gd"
SceneTransition="*res://autoloads/SceneTransition.gd"
InteractionManager="*res://autoloads/InteractionManager.gd"
GardenManager="*res://autoloads/GardenManager.gd"
UserManager="*res://autoloads/UserManager.gd"
ZoneManager="*res://autoloads/ZoneManager.gd"
FocusManager="*res://autoloads/FocusManager.gd"
InventoryManager="*res://autoloads/InventoryManager.gd"
ItemIconRegistry="*res://autoloads/ItemIconRegistry.gd"
WeatherManager="*res://autoloads/WeatherManager.gd"
DecoManager="*res://autoloads/DecoManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://themes/game_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
textures/decals/filter=0
