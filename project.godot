; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CHAM Flora"
run/main_scene="res://scenes/shared/SplashScene.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/ico/splash_icon.png"
config/icon="res://assets/ico/ico.png"

[autoload]

LoadingScreen="*res://scenes/shared/LoadingScreen.tscn"
AudioManager="*res://autoloads/AudioManager.gd"
SceneTransition="*res://autoloads/SceneTransition.gd"
InteractionManager="*res://autoloads/InteractionManager.gd"
GardenManager="*res://autoloads/GardenManager.gd"
UserManager="*res://autoloads/UserManager.gd"
TipManager="*res://autoloads/TipManager.gd"
ZoneManager="*res://autoloads/ZoneManager.gd"
FocusManager="*res://autoloads/FocusManager.gd"
InventoryManager="*res://autoloads/InventoryManager.gd"
TaskManager="*res://autoloads/TaskManager.gd"
ItemIconRegistry="*res://autoloads/ItemIconRegistry.gd"
WeatherManager="*res://autoloads/WeatherManager.gd"
DecoManager="*res://autoloads/DecoManager.gd"
GiftCodeManager="*res://autoloads/GiftCodeManager.gd"

[display]

window/size/viewport_width=700
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://themes/game_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/decals/filter=0
